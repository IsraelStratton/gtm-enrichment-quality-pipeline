# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local data: real Clay exports and run outputs never enter the repo
data/
exports/
*.local.csv

# Raw n8n exports may contain credential references — commit only the stripped copy
n8n/*.raw.json

.DS_Store

# Local agent settings
.claude/

# Filled-in n8n imports hold the tracker and credential IDs
slice/n8n/*.local.json

# Private values the pre-push check looks for (tool IDs); never committed
.prepush-private.local
