<?xml version="1.0" encoding="UTF-8"?>
<!-- INIT-164 (KB-138 C6): least access for the routing explainer agent's user, tied to the Einstein
     Agent licence so it can be given to an agent user only. Read on Account and its routing fields;
     run the one read-only action. No create, edit or delete, no other object, no system permission. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>GtmRoutingExplainer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Lets the Agentforce routing explainer read Accounts and the GTM v2 routing fields, and run its one read-only action. No create, edit or delete.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Clay_Domain_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Decision_Stamp__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Priority__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Route__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Routing_Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Routing_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GTM_Routing_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>GTM v2 routing explainer (read)</label>
    <license>Einstein Agent</license>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
