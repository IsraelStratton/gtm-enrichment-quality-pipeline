# Copy to .env and fill in locally. .env is git-ignored — never commit it.

# HubSpot service key (Settings → Integrations → Service keys).
# Scopes: crm.objects.companies.read, crm.objects.companies.write
HUBSPOT_SERVICE_KEY=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: lets the smoke test print a link to the record. The portal ID is under
# Settings → Account defaults; app host for the AU data centre is app-ap1.hubspot.com.
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_HOST=app-ap1.hubspot.com
