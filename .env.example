# Copy to .env and fill in locally. .env is git-ignored — never commit it.

# HubSpot service key (Settings → Integrations → Service keys).
# Scopes: crm.objects.companies.read, crm.objects.companies.write
HUBSPOT_SERVICE_KEY=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: lets the smoke test print a link to the record. The portal ID is under
# Settings → Account defaults; app host for the AU data centre is app-ap1.hubspot.com.
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_HOST=app-ap1.hubspot.com

# Chapter 3 slice. The tracker ID and the Make and Zapier webhook URLs stay here, never in tracked files.
# N8N_BASE_URL defaults to http://localhost:5678 in scripts/fire_slice.py.
N8N_BASE_URL=
SLICE_TRACKER_ID=
SLICE_URL_MAKE=
SLICE_URL_ZAPIER=

# Chapter 2. The Claude key from the Claude Console workspace gtm-pipeline (US$10 monthly limit).
# Read by scripts/route_leads.py only; never set it globally in the shell.
ANTHROPIC_API_KEY=
# The run log's add-only login, gtm_v2_pipeline. scripts/setup_run_log.py makes it and fills this in.
GTM_V2_DB_PASSWORD=
# Optional overrides (defaults shown): SUPABASE_DB_CONTAINER=supabase_db_hubspot-ai-database,
# GTM_V2_DB_HOST=127.0.0.1, GTM_V2_DB_PORT=54322, GTM_V2_DB_NAME=postgres

# The n8n API key (n8n Settings, n8n API). Read by scripts/n8n_publish_routing.py and scripts/render_n8n_slice.py
# to find credentials and data tables by name; never printed.
N8N_API_KEY=

# Chapter 3: the webhook keys. Each tool holds its own copy; these are what scripts/fire_slice.py sends.
SLICE_KEY_N8N=
SLICE_KEY_MAKE=
SLICE_KEY_ZAPIER=

# Chapter 4: the routing workflow's Salesforce login (External Client App, client credentials, scope api only).
# The org's My Domain host is private: it lives here and in the n8n credential, never in a tracked file.
SALESFORCE_DOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Chapter 5: the quote desk's own Salesforce login, and its API-only user's username.
SALESFORCE_DESK_CLIENT_ID=
SALESFORCE_DESK_CLIENT_SECRET=
SALESFORCE_DESK_USER=

# INIT-164: the Agentforce explainer's agent user (filled into the git-ignored local Agent Script copy).
SALESFORCE_EXPLAINER_AGENT_USER=
